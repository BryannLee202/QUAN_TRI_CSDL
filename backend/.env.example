# ============================================================================
# Cấu hình Môi trường Backend - MushroomCloud
# ============================================================================

# Cổng khởi chạy Server
PORT=5000

# Cấu hình Kết nối CSDL SQL Server (Chế độ SQL Authentication / Docker)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=SmartMushroomDB
DB_USER=sa
DB_PASSWORD=YourStrong@Password123
MSSQL_SA_PASSWORD=YourStrong@Password123
DB_ENCRYPT=false

# Cấu hình Windows Authentication (nếu dùng trực tiếp SSMS cục bộ trên Windows)
# DB_TRUSTED_CONNECTION=true
# DB_DRIVER=ODBC Driver 17 for SQL Server

# Cấu hình Bảo mật JWT
JWT_SECRET=super_secret_jwt_key_mushroomcloud_2026_@fpt
JWT_EXPIRES_IN=7d
